PORT=3000

# Optional live public-data adapter for Free Fire Community API.
FF_API_KEY=
FF_API_BASE_URL=https://developers.freefirecommunity.com/api/v1

# Optional MLBB public-data adapter. Use placeholders in the URL.
# Example shape only: https://provider.example/player?role={playerId}&zone={zoneId}
MLBB_PUBLIC_API_URL=
MLBB_PUBLIC_API_KEY=

# Optional IPWho API key. Without it, CYBERTRMX uses the public ipwho.is endpoint.
IPWHO_API_KEY=
